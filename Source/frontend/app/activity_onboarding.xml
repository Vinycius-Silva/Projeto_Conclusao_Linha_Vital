<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOnboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:minHeight="64dp">
        <Space android:layout_width="48dp" android:layout_height="1dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Brand"
                android:text="@string/app_name"
                android:layout_marginStart="7dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnSkip"
            style="@style/Widget.LinhaVital.Button.Text"
            android:text="@string/activity_onboarding_btnskip_text"
            android:minWidth="48dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/onboardingScroll"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/pageContent"
            android:orientation="vertical"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingBottom="24dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/lv_onboarding_art_height"
                android:background="@drawable/lv_illustration_background"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:padding="20dp"
                android:importantForAccessibility="noHideDescendants">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/ivIllustration"
                    android:src="@drawable/figma_welcome_person"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvEyebrow"
                style="@style/TextAppearance.LinhaVital.Caption"
                android:text="@string/activity_onboarding_tveyebrow_text"
                android:gravity="center"
                android:textColor="@color/lv_brand"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.LinhaVital.Title"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:accessibilityHeading="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvBody"
                style="@style/TextAppearance.LinhaVital.Body"
                android:gravity="center"
                android:layout_marginBottom="20dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.LinhaVital.Card"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvDetail"
                        style="@style/TextAppearance.LinhaVital.Caption"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingBottom="8dp"
        android:paddingTop="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/pageDots"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:importantForAccessibility="noHideDescendants">
            <View
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:id="@+id/dot1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/lv_dot" />
            <View
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:id="@+id/dot2"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/lv_dot" />
            <View
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:id="@+id/dot3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/lv_dot" />
            <View
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:id="@+id/dot4"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/lv_dot" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnNext"
            style="@style/Widget.LinhaVital.Button.Primary"
            android:text="@string/activity_onboarding_btnnext_text"
            app:icon="@drawable/ic_lv_arrow"
            app:iconGravity="textEnd" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvProgress"
            style="@style/TextAppearance.LinhaVital.Caption"
            android:text="@string/activity_onboarding_tvprogress_text"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</LinearLayout>
