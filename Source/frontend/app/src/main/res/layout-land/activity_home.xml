<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/headerHome"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:minHeight="64dp">
        <Space android:layout_width="48dp" android:layout_height="1dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Brand"
                android:text="@string/app_name"
                android:layout_marginStart="7dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnLogout"
            style="@style/Widget.LinhaVital.Button.Text"
            android:text="@string/activity_home_btnlogout_text"
            android:minWidth="48dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/dashboardScroll"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/dashboardContent"
            android:orientation="vertical"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingBottom="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvBemVindo"
                style="@style/TextAppearance.LinhaVital.Title"
                android:text="@string/activity_home_tvbemvindo_text"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:accessibilityHeading="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Section"
                android:text="@string/activity_home_10_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Body"
                android:text="@string/activity_home_11_text"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/cardMonitoramento"
                style="@style/Widget.LinhaVital.Card"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/lv_surface_tinted">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lv_clock"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:id="@+id/tvMonitoramentoStatus"
                            style="@style/TextAppearance.LinhaVital.Section"
                            android:text="@string/activity_home_tvmonitoramentostatus_text"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvProximoCheckIn"
                        style="@style/TextAppearance.LinhaVital.Body"
                        android:text="@string/activity_home_tvproximocheckin_text"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/btnCheckIn"
                        style="@style/Widget.LinhaVital.Button.Primary"
                        android:text="@string/activity_home_btncheckin_text"
                        app:icon="@drawable/ic_lv_check"
                        app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/btnConfigurarMonitoramento"
                        style="@style/Widget.LinhaVital.Button.Text"
                        android:text="@string/activity_home_btnconfigurarmonitoramento_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.LinhaVital.Card"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.LinhaVital.Section"
                        android:text="@string/activity_home_22_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvContatoPrioritario"
                        style="@style/TextAppearance.LinhaVital.Body"
                        android:text="@string/activity_home_tvcontatoprioritario_text"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/btnVerContatos"
                        style="@style/Widget.LinhaVital.Button.Text"
                        android:text="@string/activity_home_btnvercontatos_text"
                        app:icon="@drawable/ic_nav_contacts"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/sosPanel"
        android:orientation="vertical"
        android:background="@color/lv_surface"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnSOS"
            style="@style/Widget.LinhaVital.Button.Primary"
            android:text="@string/activity_home_btnsos_text"
            app:icon="@drawable/ic_nav_phone"
            app:iconGravity="textStart"
            android:minHeight="60dp"
            android:textSize="24sp"
            android:contentDescription="@string/activity_home_btnsos_contentdescription" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LinhaVital.Caption"
            android:text="@string/activity_home_27_text"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>
    <include android:id="@+id/bottomNavigation" layout="@layout/view_bottom_navigation"/>
</LinearLayout>
