<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    style="@style/Widget.LinhaVital.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <TextView
                android:id="@+id/tvAvatarContato"
                android:layout_width="48dp"
                android:layout_height="48dp"
                style="@style/TextAppearance.LinhaVital.Section"
                android:gravity="center"
                android:background="@drawable/lv_avatar_background"
                android:textColor="@color/lv_brand"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvPrioritario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_contato_prioritario"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/item_contato_prioritario_text"
                    android:textColor="@color/lv_brand"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvNomeContato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LinhaVital.Section"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvTelefoneContato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LinhaVital.Body"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:id="@+id/tvTipoContato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LinhaVital.Caption"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnArrastar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_drag_handle"
                style="@style/Widget.LinhaVital.IconButton"
                android:contentDescription="@string/item_contato_arrastar_contentdescription"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLigar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.LinhaVital.Button.Outline"
                android:text="@string/item_contato_btnligar_text"
                app:icon="@drawable/ic_nav_phone"
                app:iconGravity="textStart"
                android:minHeight="48dp" />

            <ImageButton
                android:id="@+id/btnEditar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_nav_edit"
                style="@style/Widget.LinhaVital.IconButton"
                android:contentDescription="@string/item_contato_btneditar_contentdescription"
                android:layout_marginStart="8dp" />

            <ImageButton
                android:id="@+id/btnDeletar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_lv_delete"
                style="@style/Widget.LinhaVital.IconButton"
                android:contentDescription="@string/item_contato_btndeletar_contentdescription"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>