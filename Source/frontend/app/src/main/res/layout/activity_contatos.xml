<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContatos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerContatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:minHeight="64dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_lv_back"
            style="@style/Widget.LinhaVital.IconButton"
            android:contentDescription="@string/lv_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextAppearance.LinhaVital.Title"
            android:text="@string/activity_contatos_8_text"
            android:gravity="center"
            android:accessibilityHeading="true"
            android:textSize="24sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabAdicionarContato"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            style="@style/Widget.LinhaVital.Button.Outline"
            android:text=""
            app:icon="@drawable/ic_lv_add"
            app:iconGravity="textStart"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:contentDescription="@string/activity_contatos_fabadicionarcontato_text"
            app:iconPadding="0dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvOrdemAjuda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LinhaVital.Caption"
        android:text="@string/activity_contatos_ordem_ajuda"
        android:textColor="@color/lv_muted"
        android:layout_marginStart="@dimen/lv_page_gutter"
        android:layout_marginEnd="@dimen/lv_page_gutter"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvListError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LinhaVital.Error"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressContatos"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="invisible"
        android:indeterminate="true"
        app:indicatorColor="@color/lv_brand"
        app:trackColor="@color/lv_surface_tinted"
        android:contentDescription="@string/lv_loading" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContatos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/TextAppearance.LinhaVital.Body"
            android:text="@string/activity_contatos_tvempty_text"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            android:drawableTop="@drawable/ic_nav_contacts"
            android:drawablePadding="16dp" />

    </FrameLayout>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/view_bottom_navigation" />

</LinearLayout>