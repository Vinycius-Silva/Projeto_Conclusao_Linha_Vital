<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/rootContatos"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5F5">

    <!-- Header: recebe o inset superior da barra de status. -->
    <LinearLayout
        android:id="@+id/headerContatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/circle_background"
            android:padding="6dp"
            android:contentDescription="Voltar" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_logo"
            android:layout_marginStart="12dp"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Contatos de Emergência"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/newsreader_regular" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdicionarContato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#BB0013"
            app:fabSize="mini" />
    </LinearLayout>

    <!-- Lista de contatos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContatos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Nenhum contato cadastrado.\nToque em + para adicionar."
        android:gravity="center"
        android:textColor="#9E9E9E"
        android:textSize="15sp"
        android:fontFamily="@font/public_sans"
        android:visibility="gone" />

</LinearLayout>
