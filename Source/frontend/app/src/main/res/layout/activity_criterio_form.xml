<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCriterioForm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/headerCriterioForm"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:minHeight="64dp">
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/btnVoltar"
            android:src="@drawable/ic_lv_back"
            style="@style/Widget.LinhaVital.IconButton"
            android:contentDescription="@string/lv_back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Brand"
                android:text="@string/app_name"
                android:layout_marginStart="7dp" />
        </LinearLayout>
        <Space android:layout_width="48dp" android:layout_height="1dp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/criterionFormScroll"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingBottom="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Title"
                android:text="@string/activity_criterio_form_9_text"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:accessibilityHeading="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Section"
                android:text="@string/activity_criterio_form_10_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Body"
                android:text="@string/activity_criterio_form_11_text"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.LinhaVital.Card"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/lv_surface_tinted">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/switchMonitoramento"
                        android:minHeight="56dp"
                        android:text="@string/activity_criterio_form_switchmonitoramento_text"
                        android:textColor="@color/lv_ink"
                        android:textSize="16sp"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LinhaVital.Label"
                    android:text="@string/activity_criterio_form_16_text"
                    android:labelFor="@id/spinnerIntervalo"
                    android:layout_marginBottom="8dp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/spinnerIntervalo"
                        android:minHeight="56dp"
                        android:background="@drawable/lv_field_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="44dp"
                        android:popupBackground="@color/lv_surface"
                        android:spinnerMode="dropdown" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lv_chevron_down"
                        android:importantForAccessibility="no"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:clickable="false" />
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Caption"
                android:text="@string/activity_criterio_form_20_text"
                android:layout_marginBottom="24dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvFormError"
                style="@style/TextAppearance.LinhaVital.Error"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                android:layout_marginBottom="16dp" />
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnSalvar"
                style="@style/Widget.LinhaVital.Button.Primary"
                android:text="@string/activity_criterio_form_btnsalvar_text" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="36dp">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:id="@+id/progressBar"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminate="true"
                    android:contentDescription="@string/lv_loading"
                    app:indicatorSize="24dp"
                    app:trackThickness="2dp"
                    app:indicatorColor="@color/lv_brand" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
