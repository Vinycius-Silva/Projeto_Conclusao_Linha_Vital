<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/rootHome"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5F5">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Logo" />

        <TextView
            android:id="@+id/tvBemVindo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Olá, Usuário!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/newsreader_regular" />

        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sair"
            android:textColor="#BB0013"
            android:textSize="14sp"
            android:fontFamily="@font/public_sans"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Conteúdo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O Linha Vital está\nmonitorando você."
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:fontFamily="@font/newsreader_regular"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seus contatos de emergência serão acionados automaticamente caso necessário."
            android:textSize="14sp"
            android:textColor="#757575"
            android:fontFamily="@font/public_sans"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Botão SOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSOS"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:text="SOS"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="@font/public_sans"
            android:layout_marginTop="40dp"
            android:backgroundTint="#BB0013"
            app:cornerRadius="80dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pressione 3x para acionar emergência"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:fontFamily="@font/public_sans"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <include layout="@layout/view_bottom_navigation" />

</LinearLayout>
