<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:elevation="10dp">

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iconNavHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Início" />

            <TextView
                android:id="@+id/labelNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Início"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#BB0013"
                android:fontFamily="@font/public_sans" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavContatos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iconNavContatos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_contacts"
                android:contentDescription="Contatos" />

            <TextView
                android:id="@+id/labelNavContatos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Contatos"
                android:textSize="12sp"
                android:textColor="#757575"
                android:fontFamily="@font/public_sans" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavCriterios"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iconNavCriterios"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_criteria"
                android:contentDescription="Critérios" />

            <TextView
                android:id="@+id/labelNavCriterios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Critérios"
                android:textSize="12sp"
                android:textColor="#757575"
                android:fontFamily="@font/public_sans" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
