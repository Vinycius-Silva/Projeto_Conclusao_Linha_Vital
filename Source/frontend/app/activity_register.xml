<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRegister"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_background"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:minHeight="64dp">
            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/btnVoltar"
                android:src="@drawable/ic_lv_back"
                style="@style/Widget.LinhaVital.IconButton"
                android:contentDescription="@string/lv_back" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_logo"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.LinhaVital.Brand"
                    android:text="@string/app_name"
                    android:layout_marginStart="7dp" />
            </LinearLayout>
            <Space android:layout_width="48dp" android:layout_height="1dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/registerContent"
            android:orientation="vertical"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingBottom="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Title"
                android:text="@string/activity_register_9_text"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:accessibilityHeading="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Body"
                android:text="@string/activity_register_10_text"
                android:gravity="center"
                android:layout_marginBottom="24dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/inputName"
                style="@style/Widget.LinhaVital.TextInput"
                android:hint="@string/activity_register_inputname_hint"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_lv_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/etName"
                    style="@style/Widget.LinhaVital.EditText"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:autofillHints="personName" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/inputEmail"
                style="@style/Widget.LinhaVital.TextInput"
                android:hint="@string/activity_register_inputemail_hint"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_lv_mail">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/etEmail"
                    style="@style/Widget.LinhaVital.EditText"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:autofillHints="emailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/inputPhone"
                style="@style/Widget.LinhaVital.TextInput"
                android:hint="@string/activity_register_inputphone_hint"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_nav_phone">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/etPhone"
                    style="@style/Widget.LinhaVital.EditText"
                    android:inputType="phone"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:autofillHints="phone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/inputBirthDate"
                style="@style/Widget.LinhaVital.TextInput"
                android:hint="@string/activity_register_inputbirthdate_hint"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_lv_calendar">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/etBirthDate"
                    style="@style/Widget.LinhaVital.EditText"
                    android:inputType="date"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/inputPassword"
                style="@style/Widget.LinhaVital.TextInput"
                android:hint="@string/activity_register_inputpassword_hint"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_lv_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/etPassword"
                    style="@style/Widget.LinhaVital.EditText"
                    android:inputType="textPassword"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:autofillHints="newPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/inputConfirmPassword"
                style="@style/Widget.LinhaVital.TextInput"
                android:hint="@string/activity_register_inputconfirmpassword_hint"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_lv_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/etConfirmPassword"
                    style="@style/Widget.LinhaVital.EditText"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:autofillHints="newPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvFormError"
                style="@style/TextAppearance.LinhaVital.Error"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                android:layout_marginBottom="16dp" />
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnCadastrar"
                style="@style/Widget.LinhaVital.Button.Primary"
                android:text="@string/activity_register_btncadastrar_text" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="36dp">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:id="@+id/progressBar"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminate="true"
                    android:contentDescription="@string/lv_loading"
                    app:indicatorSize="24dp"
                    app:trackThickness="2dp"
                    app:indicatorColor="@color/lv_brand" />
            </FrameLayout>
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tvLogin"
                style="@style/Widget.LinhaVital.Button.Text"
                android:text="@string/activity_register_tvlogin_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
