<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContatos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/headerContatos"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:minHeight="64dp">
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:id="@+id/btnVoltar"
            android:src="@drawable/ic_lv_back"
            style="@style/Widget.LinhaVital.IconButton"
            android:contentDescription="@string/lv_back" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Brand"
                android:text="@string/app_name"
                android:layout_marginStart="7dp" />
        </LinearLayout>
        <Space android:layout_width="48dp" android:layout_height="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LinhaVital.Title"
            android:text="@string/activity_contatos_8_text"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:accessibilityHeading="true" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/fabAdicionarContato"
            style="@style/Widget.LinhaVital.Button.Outline"
            android:text="@string/activity_contatos_fabadicionarcontato_text"
            app:icon="@drawable/ic_lv_add"
            app:iconGravity="textStart" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvListError"
            style="@style/TextAppearance.LinhaVital.Error"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:id="@+id/progressContatos"
        android:visibility="invisible"
        android:indeterminate="true"
        app:indicatorColor="@color/lv_brand"
        app:trackColor="@color/lv_surface_tinted"
        android:contentDescription="@string/lv_loading" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/rvContatos"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tvEmpty"
            style="@style/TextAppearance.LinhaVital.Body"
            android:text="@string/activity_contatos_tvempty_text"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            android:drawableTop="@drawable/ic_nav_contacts"
            android:drawablePadding="16dp" />
    </FrameLayout>
    <include android:id="@+id/bottomNavigation" layout="@layout/view_bottom_navigation"/>
</LinearLayout>
