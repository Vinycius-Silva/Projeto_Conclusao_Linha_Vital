<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCriterios"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/headerCriterios"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/lv_page_gutter"
        android:paddingEnd="@dimen/lv_page_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:minHeight="64dp">
        <Space android:layout_width="48dp" android:layout_height="1dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Brand"
                android:text="@string/app_name"
                android:layout_marginStart="7dp" />
        </LinearLayout>
        <Space android:layout_width="48dp" android:layout_height="1dp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/criteriaScroll"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/criteriaContent"
            android:orientation="vertical"
            android:paddingStart="@dimen/lv_page_gutter"
            android:paddingEnd="@dimen/lv_page_gutter"
            android:paddingBottom="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Title"
                android:text="@string/activity_criterios_9_text"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:accessibilityHeading="true" />
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnAdicionarCriterio"
                style="@style/Widget.LinhaVital.Button.Outline"
                android:text="@string/activity_criterios_btnadicionarcriterio_text"
                app:icon="@drawable/ic_nav_edit"
                app:iconGravity="textStart" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LinhaVital.Caption"
                android:text="@string/activity_criterios_11_text"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.LinhaVital.Card"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_phone"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.LinhaVital.Section"
                        android:text="@string/activity_criterios_15_text"
                        android:layout_marginTop="12dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.LinhaVital.Body"
                        android:text="@string/activity_criterios_16_text"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/cardInatividade"
                style="@style/Widget.LinhaVital.Card"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/lv_surface_tinted"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="@color/lv_ripple">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lv_clock"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.LinhaVital.Section"
                        android:text="@string/activity_criterios_20_text"
                        android:layout_marginTop="12dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvStatusInatividade"
                        style="@style/TextAppearance.LinhaVital.Label"
                        android:text="@string/activity_criterios_tvstatusinatividade_text"
                        android:textColor="@color/lv_brand"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvDescricaoInatividade"
                        style="@style/TextAppearance.LinhaVital.Body"
                        android:text="@string/activity_criterios_tvdescricaoinatividade_text"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.LinhaVital.Card"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.LinhaVital.Section"
                        android:text="@string/activity_criterios_25_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.LinhaVital.Caption"
                        android:text="@string/activity_criterios_26_text"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <include android:id="@+id/bottomNavigation" layout="@layout/view_bottom_navigation"/>
</LinearLayout>
