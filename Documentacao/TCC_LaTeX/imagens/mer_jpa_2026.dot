digraph LV {
graph [bgcolor="white", rankdir=LR, nodesep=.5, ranksep=1.1, splines=polyline, pad="0.2", fontname="DejaVu Sans"];
edge [color="#66788a", arrowsize=.55, penwidth=1.15, fontname="DejaVu Sans", fontsize=11];
node [shape=plain, fontname="DejaVu Sans"];
"Usuario" [label=<<TABLE BORDER="1" COLOR="#adbdca" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f4567"><FONT COLOR="white" POINT-SIZE="14"><B>Usuario</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7"><FONT POINT-SIZE="10">usuario</FONT></TD></TR></TABLE>>];
