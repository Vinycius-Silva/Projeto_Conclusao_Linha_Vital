"Dispositivo" [label=<<TABLE BORDER="1" COLOR="#adbdca" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f4567"><FONT COLOR="white" POINT-SIZE="14"><B>Dispositivo</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf1f7"><FONT POINT-SIZE="10">dispostivo</FONT></TD></TR></TABLE>>];
