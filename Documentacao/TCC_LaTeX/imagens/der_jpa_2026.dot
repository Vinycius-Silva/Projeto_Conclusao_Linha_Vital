digraph LV {
graph [bgcolor="white", rankdir=LR, nodesep=.5, ranksep=1.1, splines=polyline, pad="0.2", fontname="DejaVu Sans"];
edge [color="#66788a", arrowsize=.55, penwidth=1.15, fontname="DejaVu Sans", fontsize=11];
node [shape=plain, fontname="DejaVu Sans"];
"Usuario" [label=<<TABLE BORDER="1" COLOR="#adbdca" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f4567" COLSPAN="2"><FONT COLOR="white"><B>Usuario</B></FONT></TD></TR><TR><TD BGCOLOR="#e6edf5" COLSPAN="2"><FONT POINT-SIZE="10">usuario</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id_usuario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">nome_usuario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">email_usuario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">telefone_usuario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">data_nascimento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">senha_usuario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">fcm_token</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR/TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">oauth_provider</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">oauth_subject</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR></TABLE>>];
